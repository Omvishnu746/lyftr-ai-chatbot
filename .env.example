# ==================================================
# LYFTR AI CHATBOT — ENVIRONMENT CONFIGURATION
# ==================================================

# AI Provider Credentials (Gemini API keys, comma-separated)
# Provide at least two keys to enable automatic key failover
LLM_API_KEYS=your_first_gemini_api_key,your_second_gemini_api_key

# Model to use with LiteLLM
LLM_MODEL=gemini/gemini-3.5-flash-lite

# SQLite Database Location
# In Docker: sqlite:////data/app.db
# Local development outside Docker: sqlite:///./data/app.db
DATABASE_URL=sqlite:////data/app.db

# Allowed CORS Origins (comma-separated or *)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Enable failure simulation header X-Simulate-Failure (true / false)
ENABLE_FAILURE_SIMULATION=true

# Frontend Configuration
# URL pointing to the backend API (used during Vite build / runtime)
VITE_API_BASE_URL=http://localhost:8000

# Backend Port (Railway sets PORT automatically)
PORT=8000
